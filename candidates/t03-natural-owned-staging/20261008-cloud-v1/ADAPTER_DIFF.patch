+# Ownership comes only from successful non-recursive mkdir, never from this nonce.
+# Cooperating calls own distinct staging; target replacement/CAS is unchanged.
+func _create_save_staging(path: String) -> Dictionary:
+	var nonce: PackedByteArray = _new_save_staging_nonce()
+	if nonce.size() != 32: return C.fail("SAVE_FAILED","无法分配本次暂存标识，未写入。")
+	var parent: String = ProjectSettings.globalize_path(path).simplify_path().get_base_dir()
+	var directory: String = parent.path_join(".words-and-perils-natural-stage-" + nonce.hex_encode())
+	var created: Error = _make_save_staging_directory(directory)
+	if created != OK: return C.fail("SAVE_FAILED","本次暂存目录未能独占创建，未认领或修改已有目录。")
+	return {"ok":true,"directory":directory,"payload":directory.path_join("payload.json")}
+func _new_save_staging_nonce() -> PackedByteArray:
+	return Crypto.new().generate_random_bytes(32)
+func _make_save_staging_directory(path: String) -> Error:
+	return DirAccess.make_dir_absolute(path)
+func _open_save_staging_readback(path: String) -> RefCounted:
+	return FileAccess.open(path,FileAccess.READ)
+func _verify_save_staging(path: String, expected: PackedByteArray) -> bool:
+	var file := _open_save_staging_readback(path)
+	if file == null: return false
+	if file.get_length() != expected.size():
+		file.close()
+		return false
+	var actual: PackedByteArray = file.get_buffer(expected.size())
+	var read_error: Error = file.get_error(); file.close()
+	return actual == expected and read_error in [OK,ERR_FILE_EOF]
+func _save_staging_payload_exists(path: String) -> bool:
+	return FileAccess.file_exists(path)
+func _remove_save_staging_path(path: String) -> Error:
+	return DirAccess.remove_absolute(path)
+func _cleanup_save_staging(staging: Dictionary, remove_payload: bool) -> Error:
+	if remove_payload and _save_staging_payload_exists(staging.payload):
+		var removed: Error = _remove_save_staging_path(staging.payload)
+		if removed != OK: return removed
+	# Native remove must reject a nonempty directory. Do not scan or recurse.
+	return _remove_save_staging_path(staging.directory)
+func _save_failed_before_rename(staging: Dictionary, message: String) -> Dictionary:
+	var failed: Dictionary = C.fail("SAVE_FAILED",message)
+	var cleanup_error: Error = _cleanup_save_staging(staging,true)
